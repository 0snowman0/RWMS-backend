{
  "AuditLogSettings": {
    "Enabled": false,
    "AllowedActions": [
      "Insert",
      "Update",
      "Delete"
    ],
    "InclusionMode": "Exclude",
    "Tables": [
      "alembic_version",
      "audit_logs",
      "logs"
    ],
    "Batching": {
      "BatchSize": 100,
      "EnablePeriodicFlush": true,
      "FlushIntervalInSeconds": 5.0
    }
  }
}
